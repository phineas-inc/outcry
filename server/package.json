{
  "name": "outcry-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "test": "node --test test/api.test.ts",
    "seed:sql": "node scripts/seed-sql.ts > seed.sql",
    "dev:worker": "npm run seed:sql && wrangler d1 execute outcry --local --file=seed.sql && wrangler dev --port 8788",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
